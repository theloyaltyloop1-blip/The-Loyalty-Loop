{
  "expo": {
    "name": "The Loyalty Loop",
    "slug": "localoop-rewards",
    "version": "1.0.0",
    "scheme": "loyaltyloop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theloyaltyloop.shopper"
    },
    "android": {
      "package": "com.theloyaltyloop.shopper",
      "versionCode": 113,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8E4C6",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8E4C6"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4F6438"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Loyalty Loop to use Face ID to unlock your app."
        }
      ]
    ],
    "owner": "the-loyalty-loop",
    "extra": {
      "eas": {
        "projectId": "474f40e3-c739-4317-8a94-12a73795ef04"
      }
    }
  }
}

{
  "expo": {
    "name": "The Loyalty Loop",
    "slug": "localoop-rewards",
    "version": "1.0.3",
    "scheme": "loyaltyloop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.theloyaltyloop.shopper",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "17"
    },
    "android": {
      "package": "com.theloyaltyloop.shopper",
      "versionCode": 135,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8E4C6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8E4C6"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4F6438"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Loyalty Loop to use Face ID to unlock your app."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow The Loyalty Loop to use your location to show the closest shops first. Your location stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": "If you turn on walk-past alerts, The Loyalty Loop uses your location in the background to tell you about offers from shops you walk past. Your location stays on your phone; only the shop you passed is checked.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "owner": "the-loyalty-loop",
    "extra": {
      "eas": {
        "projectId": "474f40e3-c739-4317-8a94-12a73795ef04"
      }
    }
  }
}

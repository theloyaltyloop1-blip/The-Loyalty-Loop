# Dedicated PostgreSQL database. Do not point migrations at the existing app DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyalty_loop
PORT=3001
# Copy the secretKey for this transaction.auth subscription from Fidel.
FIDEL_WEBHOOK_SECRET=
# Must exactly match the URL registered with Fidel, including path/query/slash.
FIDEL_WEBHOOK_URL=https://your-api.example/webhooks/fidel
FIDEL_ACCOUNT_ID=
FIDEL_PROGRAM_ID=

{
  "expo": {
    "name": "The Loyalty Loop for Business",
    "slug": "localoop-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theloyaltyloop.retailer"
    },
    "android": {
      "package": "com.theloyaltyloop.retailer",
      "versionCode": 105,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8E4C6",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4F6438"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Loyalty Loop for Business to use Face ID to unlock your app."
        }
      ]
    ],
    "owner": "the-loyalty-loop",
    "extra": {
      "eas": {
        "projectId": "de0702d2-219a-435b-8577-81546c5a097f"
      }
    }
  }
}

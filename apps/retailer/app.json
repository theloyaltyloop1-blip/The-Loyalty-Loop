{
  "expo": {
    "name": "The Loyalty Loop for Business",
    "slug": "localoop-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theloyaltyloop.retailer"
    },
    "android": {
      "package": "com.theloyaltyloop.retailer",
      "versionCode": 112,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8E4C6",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8E4C6"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4F6438"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Loyalty Loop for Business to use Face ID to unlock your app."
        }
      ]
    ],
    "owner": "the-loyalty-loop",
    "extra": {
      "eas": {
        "projectId": "de0702d2-219a-435b-8577-81546c5a097f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/de0702d2-219a-435b-8577-81546c5a097f"
    }
  }
}

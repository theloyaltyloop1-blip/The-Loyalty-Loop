{
  "expo": {
    "name": "The Loyalty Loop for Business",
    "slug": "localoop-business",
    "version": "1.0.0",
    "scheme": "loyaltyloop-business",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theloyaltyloop.retailer",
      "appleTeamId": "9QSSA475TR",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.theloyaltyloop.retailer"
        ]
      }
    },
    "android": {
      "package": "com.theloyaltyloop.retailer",
      "versionCode": 116,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8E4C6",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8E4C6"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#4F6438"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Loyalty Loop for Business to use Face ID to unlock your app."
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RetailerScanWidget",
              "label": "Open scanner",
              "description": "Open the customer scanner and see today's loyalty activity.",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sqlite"
    ],
    "owner": "the-loyalty-loop",
    "extra": {
      "eas": {
        "projectId": "de0702d2-219a-435b-8577-81546c5a097f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/de0702d2-219a-435b-8577-81546c5a097f"
    }
  }
}
